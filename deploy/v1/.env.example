# New V1 deployment only. Do not copy the legacy application's .env wholesale.
API_HOST=127.0.0.1
API_PORT=9012
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
WEB_HOST=127.0.0.1
WEB_PORT=8080
BUILD_PROFILE=universal-v1
MYSQL_IMAGE=mysql:8.4.5
REDIS_IMAGE=redis:7.4.2
NGINX_IMAGE=nginx:1.27.5
CHROM_API_IMAGE=chrom-platform-api:offline
CHROM_WORKER_IMAGE=chrom-platform-worker:offline
# Required only for builds containing workers; supply an audited entrypoint.
WORKER_COMMAND=
CHROM_FRONTEND_IMAGE=nginx:1.27.5
MYSQL_DATABASE=chrom_platform
MYSQL_USER=chrom_platform
MYSQL_PASSWORD=REPLACE_ME
MYSQL_ROOT_PASSWORD=REPLACE_ME
DATABASE_URL=mysql+asyncmy://APP_USER:REPLACE_ME@mysql:3306/chrom_platform
REDIS_URL=redis://redis:6379/0
ARTIFACT_ROOT=/var/lib/chrom-platform/artifacts
# Container deployment application secret file; unrelated to the Windows V1 LLM API key, which uses protected runtime settings and CurrentUser DPAPI.
SECRET_KEY_FILE=./secrets/chrom-platform-key
TRACE_CONTENT_MODE=off
TRACE_CONTENT_RETENTION_DAYS=7
TRACE_METADATA_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
OTEL_EXPORTER_OTLP_ENDPOINT=
