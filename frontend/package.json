{
  "name": "chromatography-platform-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-registry.mjs && vite",
    "generate:registry": "node scripts/generate-registry.mjs",
    "generate:contracts": "node scripts/generate-contract-types.mjs",
    "verify:contracts": "node scripts/generate-contract-types.mjs --verify",
    "assemble:profile": "node scripts/assemble-profile.mjs",
    "verify:assembly-boundaries": "node scripts/verify-assembly-boundaries.mjs",
    "verify:profiles": "node scripts/verify-profiles.mjs",
    "build": "npm run generate:contracts && npm run generate:registry && vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "marked": "18.1.1",
    "pinia": "3.0.3",
    "vue": "3.5.22",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "2.4.6",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.1.3",
    "vue-tsc": "2.2.10"
  }
}
