# ============================================
# Chromatography_agent .env 示例
# 复制为 .env 后按实际环境填写，不要提交真实密钥
# ============================================

# ==================== LLM 配置 ====================
# 支持: siliconflow, openai, qianfan, dashscope, zhipu, moonshot, ollama
LLM_TYPE=siliconflow

# SiliconFlow / OpenAI-compatible defaults
API_KEY=your-siliconflow-api-key
BASE_URL=https://api.siliconflow.cn/v1
MODEL_ID=deepseek-ai/DeepSeek-V4-Flash
SILICONFLOW_API_KEY=
SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1

# OpenAI-compatible provider
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.nuwaapi.com/v1

# Ollama local provider
# Set LLM_TYPE=ollama to use the local Ollama OpenAI-compatible API.
OLLAMA_API_BASE=http://127.0.0.1:11434/v1
OLLAMA_MODEL_ID=deepseek-r1:8b
OLLAMA_API_KEY=ollama

# Other providers
QIANFAN_AK=
QIANFAN_SK=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=

# Optional search APIs
TAVILY_API_KEY=
SERPAPI_API_KEY=

# ==================== Prediction service URLs ====================
TLC_API_URL=http://127.0.0.1:8010/predict
CC_API_URL=http://127.0.0.1:8011/predict
HPLC_API_URL=http://127.0.0.1:8012/predict

# ==================== Agent runtime ====================
AGENT_MAX_ITERATIONS=5
AGENT_MEMORY_K=5
AGENT_TEMPERATURE=0

# ==================== Local RAG knowledge base ====================
KNOWLEDGE_BASE_DIR=knowledge_base
RAG_CHROMA_DIR=
RAG_COLLECTION_NAME=chromatography_agent_kb
RAG_TOP_K=4
RAG_MAX_SNIPPET_CHARS=700

# ==================== Gradio ====================
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=false
