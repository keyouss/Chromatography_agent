# Legacy application template; Windows V1 run-local.ps1 reads the protected runtime.json, not this file.
# For one-time V1 provisioning, only BASE_URL, MODEL_ID and API_KEY are imported from a private local .env.
# Keep API_KEY empty here; the running API/Worker read the protected runtime and CurrentUser DPAPI secret store.
# Chromatography_agent environment template. Copy to .env and keep real keys private.

# ==================== LLM ====================
# Supported: siliconflow, openai, qianfan, zhipu, ollama
LLM_TYPE=siliconflow

# Legacy app only: provider-specific entries may override the generic triple. Windows V1 provisioning reads the generic triple above once.
API_KEY=
BASE_URL=https://api.siliconflow.cn/v1
MODEL_ID=deepseek-ai/DeepSeek-V4-Flash
SILICONFLOW_API_KEY=
SILICONFLOW_API_BASE=
SILICONFLOW_MODEL_ID=

# Other supported providers
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.nuwaapi.com/v1
QIANFAN_AK=
QIANFAN_SK=
ZHIPU_API_KEY=
OLLAMA_API_BASE=http://127.0.0.1:11434/v1
OLLAMA_MODEL_ID=deepseek-r1:8b
OLLAMA_API_KEY=ollama

# Optional, currently reserved search credentials
TAVILY_API_KEY=
SERPAPI_API_KEY=

# ==================== Prediction services ====================
CHROMA_SERVICE_HOST=127.0.0.1
CHROMA_SERVICE_PORT=8010
CHROMA_SERVICE_API_BASE=http://127.0.0.1:8010
TLC_API_URL=http://127.0.0.1:8010/tlc/predict
CC_API_URL=http://127.0.0.1:8010/cc/predict
HPLC_API_URL=http://127.0.0.1:8010/hplc/predict
SFC_API_URL=http://127.0.0.1:8010/sfc/predict
GC_API_URL=http://127.0.0.1:8010/gc/predict
SERVICE_HEALTH_URL=http://127.0.0.1:8010/health
CHROMA_SERVICE_PYTHON=
START_SERVICES_WITH_UI=false

# LangChain prediction transport: mcp (default, with direct fallback) or direct.
PREDICTION_TOOL_TRANSPORT=mcp
MCP_SERVER_PYTHON=D:\Anaconda\envs\LR\python.exe
MCP_SERVER_SCRIPT=
MCP_SERVER_CWD=
MCP_INIT_TIMEOUT_SECONDS=20
MCP_CLIENT_TIMEOUT_SECONDS=30
MCP_TOOL_TIMEOUT_SECONDS=300

# ==================== Agent and context ====================
AGENT_MAX_ITERATIONS=5
AGENT_TEMPERATURE=0
# Legacy compatibility value; CONTEXT_RECENT_TURNS is authoritative.
AGENT_MEMORY_K=5
CONTEXT_ENABLED=true
CONTEXT_RECENT_TURNS=5
CONTEXT_SUMMARY_TRIGGER_CHARS=12000
CONTEXT_SUMMARY_KEEP_TURNS=3
CONTEXT_TOOL_RESULT_CHARS=1200

# Explicit long-term memory; only /remember writes persistent data.
MEMORY_ENABLED=true
MEMORY_PROFILE_ID=local-user
APP_RUNTIME_DIR=runtime
MEMORY_STORE_PATH=runtime/memories.json
MEMORY_MAX_ITEMS=30
MEMORY_MAX_CHARS=800
MEMORY_CONTEXT_MAX_ITEMS=8

# ==================== Local RAG ====================
KNOWLEDGE_BASE_DIR=knowledge_base
RAG_CHROMA_DIR=
RAG_COLLECTION_NAME=chromatography_agent_kb
RAG_INDEX_VERSION=2
RAG_EMBEDDING_PROVIDER=sentence_transformers
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_EMBEDDING_DEVICE=cpu
# Set true when the model must already be present in the local Hugging Face cache.
RAG_EMBEDDING_LOCAL_FILES_ONLY=false
RAG_RETRIEVAL_MODE=hybrid
RAG_TOP_K=4
RAG_MAX_TOP_K=8
RAG_RECALL_K=12
RAG_MIN_SCORE=0.0
RAG_VECTOR_WEIGHT=0.6
RAG_KEYWORD_WEIGHT=0.4
RAG_RRF_K=60
RAG_MAX_SNIPPET_CHARS=700

# ==================== Gradio ====================
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=false
