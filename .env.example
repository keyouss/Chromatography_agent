# ============================================
# Chromatography_agent .env 示例
# 复制为 .env 后按实际环境填写，不要提交真实密钥
# ============================================

# ==================== LLM 配置 ====================
# 支持: siliconflow, openai, qianfan, dashscope, zhipu, moonshot
LLM_TYPE=siliconflow

# SiliconFlow / OpenAI-compatible defaults
API_KEY=your-siliconflow-api-key
BASE_URL=https://api.siliconflow.cn/v1
MODEL_ID=deepseek-ai/DeepSeek-V4-Flash
SILICONFLOW_API_KEY=
SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1

# OpenAI-compatible provider
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.nuwaapi.com/v1

# Other providers
QIANFAN_AK=
QIANFAN_SK=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=

# Optional search APIs
TAVILY_API_KEY=
SERPAPI_API_KEY=

# ==================== Prediction service URLs ====================
TLC_API_URL=http://127.0.0.1:8000/predict
CC_API_URL=http://127.0.0.1:8001/predict
HPLC_API_URL=http://127.0.0.1:8002/predict

# ==================== Agent runtime ====================
AGENT_MAX_ITERATIONS=5
AGENT_MEMORY_K=5
AGENT_TEMPERATURE=0

# ==================== Gradio ====================
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=false
